EPIC_FHIR_BASE_URL=https://your-epic-instance.example.org/api/FHIR/R4
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=
EPIC_TOKEN_URL=https://your-epic-instance.example.org/oauth2/token

# Number of days a claim may sit without a status update before it is
# considered orphaned.
ORPHAN_THRESHOLD_DAYS=14

# Supabase project used to persist de-identified diagnostic telemetry
# (HMAC token IDs, waterfall stage/rule metadata - never PHI). Leave both
# blank to run with Supabase persistence disabled; supabase_writer.py
# soft-fails and no-ops when either is unset.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
