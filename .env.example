EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=
EPIC_TOKEN_URL=https://your-epic-instance.example.org/oauth2/token

# Number of days a claim may sit without a status update before it is
# considered orphaned.
ORPHAN_THRESHOLD_DAYS=14

# Supabase project backing the Phase 2 executive reporting dashboard
# (see scripts/*.sql and waterfall_guard/api/). The service role key is
# for trusted backend reads/writes only - never ship it to a client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
